{
  "name": "stockpilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Inventory Intelligence & Demand Forecasting Platform",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "lint:frontend": "npm run lint --workspace=apps/frontend",
    "lint:backend": "npm run lint --workspace=apps/backend",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json}\"",
    "test:frontend": "npm run test --workspace=apps/frontend",
    "test:backend": "npm run test --workspace=apps/backend"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
